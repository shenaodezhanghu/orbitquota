<Application x:Class="CodexIsland.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnMainWindowClose">
 <Application.Resources>
  <SolidColorBrush x:Key="Ink" Color="#F1F4F8"/>
  <SolidColorBrush x:Key="Muted" Color="#959DAE"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#1D2330"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#F1F4F8"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#18191D"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#18191D"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#F1F4F8"/>
  <Style TargetType="ContextMenu"><Setter Property="Background" Value="#171D29"/><Setter Property="Foreground" Value="#F1F4F8"/><Setter Property="BorderBrush" Value="#353C4B"/></Style>
  <Style TargetType="MenuItem"><Setter Property="Foreground" Value="#F1F4F8"/><Setter Property="Padding" Value="10,6"/></Style>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/><Setter Property="FontSize" Value="12"/></Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#A8B0C0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,7"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" CornerRadius="9" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#252B37"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.65"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Foreground" Value="#F1F4F8"/><Setter Property="Background" Value="#1D2330"/><Setter Property="BorderBrush" Value="#3A4255"/><Setter Property="Padding" Value="8"/><Setter Property="CaretBrush" Value="White"/></Style>
 </Application.Resources>
</Application>
